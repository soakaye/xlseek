# ==============================================================================
# xlseek - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local

# Testing, coverage & linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.tox/
.nox/

# Logs and databases
*.log
*.sqlite3
*.db

# Operating System files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Orca ADE (Agent Development Environment) & AI Agents
.orca/
.worktrees/
worktrees/
.cache/
.tmp/
tmp/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Tauri
target/
src-tauri/target/
src-tauri/gen/
src-tauri/resources/

src-tauri/binaries/
